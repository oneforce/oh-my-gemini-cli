{
  "description": "OMC orchestration hooks with async capabilities",
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}keyword-detector.mjs\"",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}skill-injector.mjs\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}session-start.mjs\"",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}project-memory-session.mjs\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "init",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}setup-init.mjs\"",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "maintenance",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}setup-maintenance.mjs\"",
            "timeout": 60000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}pre-tool-enforcer.mjs\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}post-tool-verifier.mjs\"",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}project-memory-posttool.mjs\"",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}post-tool-use-failure.mjs\"",
            "timeout": 3000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}pre-compact.mjs\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}project-memory-precompact.mjs\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}context-guard-stop.mjs\"",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}persistent-mode.cjs\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}code-simplifier.mjs\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${extensionPath}${/}scripts${/}run.cjs\" \"${extensionPath}${/}scripts${/}session-end.mjs\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
